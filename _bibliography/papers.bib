@article{nishat2026transfer,
 title={Transfer learning for undrained shear strength prediction: A case study with instance-based transfer},
 author={Nishat, Raied Ahmed and Rahman, Fahmida and Hoque, Nur Md. Robiul and Islam, Shriful},
 journal={Geosystems and Geoenvironment},
 year={2026}, volume={5}, number={3}, pages={100519},
 doi={10.1016/j.geogeo.2026.100519},
 html={/research/soil-transfer/},
 code={https://github.com/raiedahmed-lab/TL_USS_Prediction},
 preview={paper-tluss.png}, selected={true}, bibtex_show={true},
 abstract={Accurate estimation of undrained shear strength (USS) is critical for safe and cost-effective geotechnical design. However, limited availability of high-quality site-specific data often constrains traditional machine learning models, especially when applied across regions with heterogeneous soil characteristics. This study investigates instance-based transfer learning (TL) as a strategy to improve USS prediction in a cross-regional case study under domain shift conditions. A source dataset from Finland (217 samples) and a smaller target dataset from Sylhet, Bangladesh (134 samples) were used in this study. Statistical measures confirmed significant distributional differences between regions. Three TL methods, TrAdaBoost.R2, Two-Stage TrAdaBoost.R2, and instance weighted kernel ridge regression (IWKRR) were compared against a baseline AdaBoost.R2 trained solely on the target domain. IWKRR achieved the highest predictive accuracy (R² = 0.876, RMSE = 6.89 kPa, MAE = 5.46 kPa) and maintained stable performance even with low target data availability. SHapley Additive exPlanation (SHAP)-based interpretability analysis identified density and moisture content as the dominant features influencing predictions across both domains. This case demonstrates that instance-based TL such as IWKRR can effectively mitigate domain shift, reduce data dependency, and provide reliable USS predictions in low-resource geological settings.
}
}
@article{islam2026kaolin,
 title={Effect of lime and alkali-activated LRF slag on geotechnical properties and microstructural behavior of kaolin clay},
 author={Islam, Shriful and Nishat, Raied Ahmed and Sutradhar, Arnob and Hoque, Nur Md. Robiul and Rafi, Md. Nazmul Islam and Rana, Md. Sohel},
 journal={International Journal of Geosynthetics and Ground Engineering},
 year={2026}, volume={12}, pages={60},
 doi={10.1007/s40891-026-00738-y},
 html={/research/kaolin-stabilization/},
 preview={paper-kaolin.jpg}, selected={true}, bibtex_show={true},
 abstract={Low strength and moderate swelling tendency of kaolin clay pose significant challenges for geotechnical applications, necessitating effective stabilization techniques. This study investigated the stabilization of kaolin clay using lime and NaOH-activated Ladle Refining Furnace (LRF) slag. Mechanical properties of the stabilized clay were assessed through compaction, unconfined compressive strength (UCS), and free swell index (FSI) tests, while microstructural changes were examined using scanning electron microscopy coupled with energy-dispersive X-ray spectroscopy (SEM-EDS). Mixtures containing varying proportions of lime (3%, 5%, and 8%) and activated LRF slag (15%, 20%, and 25%) were evaluated after curing for 28 days. The optimal mixture (8% lime and 20% activated slag) achieved a UCS of 4619.8 kPa, whereas the UCS of untreated kaolin was 63.44 kPa, well exceeding typical subgrade stabilization target. This strength improvement is attributed to the synergistic interaction between lime and alkali-activated LRF slag, promoting the formation of calcium aluminosilicate hydrate (C-A-S-H) and sodium aluminosilicate hydrate (N-A-S-H) gels responsible for soil matrix densification. SEM-EDS analysis supports this mechanism through compositional changes consistent with a reduced Si/Al ratio (0.64) and a progressively densified microstructure. Swelling reduction follows the same cementation process and is consistent with the formation of C-S-H, C-A-S-H, and N-A-S-H phases. Multivariate regression identified lime and activated LRF content as the most significant factors influencing UCS. The study presents the first systematic evaluation of NaOH-activated LRF slag combined with lime as a dual-binder system for kaolin stabilization, demonstrating effective utilization of an underexplored steelmaking by-product.
}
}
